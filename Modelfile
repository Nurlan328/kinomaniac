# Локальная модель для пути за $0: qwen3.5:4b с контекстом 16K токенов.
# Ollama по умолчанию может дать модели всего 4096 токенов, а весь каталог
# films.json с правилами занимает около 9 000: без этого запрос без условий
# падает с ошибкой 400. Создание один раз:
#     ollama create kino-qwen -f Modelfile
# Запуск: uv run bot.py --local --model kino-qwen
FROM qwen3.5:4b
PARAMETER num_ctx 16384
